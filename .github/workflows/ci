name: tests

on:
  push:
  pull_request:

jobs:
  test:
    runs-on: ubuntu-latest
    strategy:
      matrix:
        compiler: [gcc, clang]
    steps:
      - uses: actions/checkout@v4
      - name: Run tests
        run: make CC=${{ matrix.compiler }} test
      - name: Run tests with sanitizers
        run: make clean && make CC=${{ matrix.compiler }} sanitize
